---
const products = [
  {
    name: 'Serie M',
    category: 'All-in-One',
    description: "Colonne LED d'entree de gamme avec fonctions PIP integrees. Ideale pour les salles de reunion.",
    pitch: '0.9 - 2.5mm',
    image: 'https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=600&h=340&fit=crop&q=80',
  },
  {
    name: 'Serie URL',
    category: 'All-in-One',
    description: "Colonne LED tactile avec processeur PIP premium. L'experience interactive ultime.",
    pitch: '0.9 - 1.8mm',
    image: 'https://images.unsplash.com/photo-1497215842964-222b430dc094?w=600&h=340&fit=crop&q=80',
  },
  {
    name: 'VDS (COB)',
    category: 'Cabinet',
    description: "Technologie COB de pointe avec option cadre tactile. Performance et durabilite.",
    pitch: '0.4 - 1.2mm',
    image: 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&h=340&fit=crop&q=80',
  },
  {
    name: 'TVF',
    category: 'Cabinet',
    description: "SMD milieu de gamme offrant un excellent rapport qualite/prix pour tous les projets.",
    pitch: '0.7 - 1.5mm',
    image: 'https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=600&h=340&fit=crop&q=80',
  },
  {
    name: 'DLP',
    category: 'Cabinet',
    description: "SMD haut de gamme fabrique en Europe. La qualite premium pour les projets exigeants.",
    pitch: '0.7 - 1.2mm',
    image: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=600&h=340&fit=crop&q=80',
  },
  {
    name: 'LUW',
    category: 'Outdoor',
    description: "Pitch ultra-fin pour l'exterieur. Des images eclatantes meme en plein soleil.",
    pitch: '2.5 - 6mm',
    image: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&h=340&fit=crop&q=80',
  },
];
---

<section class="section products" id="produits">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Catalogue</span>
      <h2>Nos gammes d'ecrans LED</h2>
      <p>
        Des solutions completes incluant mecanique, cabinets, cables,
        electronique, finitions et pieces de rechange.
      </p>
    </div>

    <div class="products-grid">
      {products.map(product => (
        <div class="product-card">
          <div class="card-image">
            <img src={product.image} alt={product.name} loading="lazy" />
            <span class="card-category">{product.category}</span>
          </div>
          <div class="card-body">
            <div class="card-top">
              <h3 class="card-title">{product.name}</h3>
              <span class="card-pitch">{product.pitch}</span>
            </div>
            <p class="card-description">{product.description}</p>
            <a href="/produits" class="card-link">
              En savoir plus
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="products-cta">
      <a href="/produits" class="btn btn-primary">
        Voir tout le catalogue
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .product-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .product-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .card-image {
    position: relative;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .product-card:hover .card-image img {
    transform: scale(1.03);
  }

  .card-image .card-category {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    padding: 0.2rem 0.6rem;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-sm);
  }

  .card-body {
    padding: 1.25rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .card-pitch {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .card-description {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }

  .card-link:hover {
    gap: 0.55rem;
  }

  .products-cta {
    text-align: center;
  }

  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
