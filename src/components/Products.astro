---
const products = [
  {
    name: 'Serie M',
    category: 'All-in-One',
    description: "Colonne LED d'entree de gamme avec fonctions PIP integrees. Ideale pour les salles de reunion.",
    pitch: '0.9 - 2.5mm',
  },
  {
    name: 'Serie URL',
    category: 'All-in-One',
    description: "Colonne LED tactile avec processeur PIP premium. L'experience interactive ultime.",
    pitch: '0.9 - 1.8mm',
  },
  {
    name: 'VDS (COB)',
    category: 'Cabinet',
    description: "Technologie COB de pointe avec option cadre tactile. Performance et durabilite.",
    pitch: '0.4 - 1.2mm',
  },
  {
    name: 'TVF',
    category: 'Cabinet',
    description: "SMD milieu de gamme offrant un excellent rapport qualite/prix pour tous les projets.",
    pitch: '0.7 - 1.5mm',
  },
  {
    name: 'DLP',
    category: 'Cabinet',
    description: "SMD haut de gamme fabrique en Europe. La qualite premium pour les projets exigeants.",
    pitch: '0.7 - 1.2mm',
  },
  {
    name: 'LUW',
    category: 'Outdoor',
    description: "Pitch ultra-fin pour l'exterieur. Des images eclatantes meme en plein soleil.",
    pitch: '2.5 - 6mm',
  },
];
---

<section class="section products" id="produits">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Catalogue</span>
      <h2>Nos gammes d'ecrans LED</h2>
      <p>
        Des solutions completes incluant mecanique, cabinets, cables,
        electronique, finitions et pieces de rechange.
      </p>
    </div>

    <div class="products-grid">
      {products.map(product => (
        <div class="product-card">
          <div class="card-header">
            <span class="card-category">{product.category}</span>
            <span class="card-pitch">Pitch : {product.pitch}</span>
          </div>
          <h3 class="card-title">{product.name}</h3>
          <p class="card-description">{product.description}</p>
          <a href="/produits" class="card-link">
            En savoir plus
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <div class="products-cta">
      <a href="/produits" class="btn btn-primary">
        Voir tout le catalogue
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .product-card {
    padding: 1.75rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base);
  }

  .product-card:hover {
    border-color: var(--color-primary-light);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-category {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    padding: 0.2rem 0.6rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
  }

  .card-pitch {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--color-text);
  }

  .card-description {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }

  .card-link:hover {
    gap: 0.55rem;
  }

  .products-cta {
    text-align: center;
  }

  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
