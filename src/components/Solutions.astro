---
const solutions = [
  {
    title: 'Salles de reunion',
    description: "Ecrans LED interactifs pour des presentations percutantes et des visioconferences immersives.",
    image: 'meeting',
  },
  {
    title: 'Retail & Affichage',
    description: "Attirez l'attention de vos clients avec des murs d'images LED grand format haute resolution.",
    image: 'retail',
  },
  {
    title: 'Evenementiel',
    description: "Des ecrans geants pour vos evenements, concerts et salons. Impact visuel garanti.",
    image: 'event',
  },
  {
    title: 'Corporate & Lobby',
    description: "Modernisez vos espaces d'accueil avec des affichages dynamiques et elegants.",
    image: 'corporate',
  },
];
---

<section class="section solutions">
  <div class="container">
    <div class="section-header">
      <div class="badge">
        <span class="badge-dot"></span>
        Applications
      </div>
      <h2>Des solutions pour <span class="gradient-text">chaque besoin</span></h2>
      <p>
        Quel que soit votre secteur, nous avons la solution LED adaptee
        a vos exigences et votre budget.
      </p>
    </div>

    <div class="solutions-grid">
      {solutions.map((solution, i) => (
        <div class="solution-card" style={`--index: ${i}`}>
          <div class="solution-visual">
            <div class="solution-placeholder">
              <div class="placeholder-lines">
                <div class="line line-1"></div>
                <div class="line line-2"></div>
                <div class="line line-3"></div>
              </div>
              <div class="placeholder-glow"></div>
            </div>
          </div>
          <div class="solution-info">
            <h3>{solution.title}</h3>
            <p>{solution.description}</p>
            <a href="/solutions" class="solution-link">
              Decouvrir
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .solution-card {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--gradient-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    overflow: hidden;
  }

  .solution-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
  }

  .solution-visual {
    flex-shrink: 0;
    width: 140px;
    height: 120px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .solution-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-bg-elevated);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 60%;
  }

  .line {
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-primary);
    opacity: 0.3;
  }

  .line-1 { width: 100%; }
  .line-2 { width: 75%; }
  .line-3 { width: 50%; }

  .placeholder-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(108, 43, 217, 0.1) 0%, transparent 60%);
  }

  .solution-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .solution-info h3 {
    font-size: 1.15rem;
    font-weight: 650;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .solution-info p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .solution-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary-light);
    transition: all var(--transition-fast);
  }

  .solution-link:hover {
    color: var(--color-accent-light);
    gap: 0.6rem;
  }

  @media (max-width: 768px) {
    .solutions-grid {
      grid-template-columns: 1fr;
    }

    .solution-card {
      flex-direction: column;
    }

    .solution-visual {
      width: 100%;
      height: 100px;
    }
  }
</style>
