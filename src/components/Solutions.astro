---
const solutions = [
  {
    title: 'Salles de reunion',
    description: "Ecrans LED interactifs pour des presentations percutantes et des visioconferences immersives.",
    image: 'https://www.planar.com/media/442435/workspaces-market-homepage-706x530.jpg',
  },
  {
    title: 'Retail & Affichage',
    description: "Murs d'images LED grand format haute resolution pour capter l'attention de vos clients.",
    image: 'https://www.planar.com/media/442437/retail-market-homepage-706x530.jpg',
  },
  {
    title: 'Evenementiel',
    description: "Ecrans geants pour vos evenements, concerts et salons. Impact visuel garanti.",
    image: 'https://www.planar.com/media/442439/events-market-homepage-706x530.jpg',
  },
  {
    title: 'Corporate & Lobby',
    description: "Modernisez vos espaces d'accueil avec des affichages dynamiques et elegants.",
    image: 'https://www.planar.com/media/442426/digital-signage-market-homepage-706x530.jpg',
  },
];
---

<section class="section solutions">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Applications</span>
      <h2>Des solutions pour chaque besoin</h2>
      <p>
        Quel que soit votre secteur, nous avons la solution LED adaptee
        a vos exigences et votre budget.
      </p>
    </div>

    <div class="solutions-grid">
      {solutions.map(solution => (
        <div class="solution-card">
          <div class="solution-image">
            <img src={solution.image} alt={solution.title} loading="lazy" />
          </div>
          <div class="solution-body">
            <h3>{solution.title}</h3>
            <p>{solution.description}</p>
            <a href="/solutions" class="solution-link">
              Decouvrir
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .solution-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .solution-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .solution-image {
    overflow: hidden;
  }

  .solution-image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .solution-card:hover .solution-image img {
    transform: scale(1.03);
  }

  .solution-body {
    padding: 1.5rem;
  }

  .solution-body h3 {
    font-size: 1.1rem;
    font-weight: 650;
    margin-bottom: 0.4rem;
    color: var(--color-text);
  }

  .solution-body p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .solution-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }

  .solution-link:hover {
    gap: 0.55rem;
  }

  @media (max-width: 768px) {
    .solutions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
