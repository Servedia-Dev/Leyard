<section class="section cta-section">
  <div class="container">
    <div class="cta-card">
      <h2>Pret a equiper vos espaces ?</h2>
      <p>
        Contactez notre equipe pour discuter de votre projet
        et obtenir un devis personnalise.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">
          Demander un devis gratuit
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="mailto:france@leyardgroup.com" class="btn btn-secondary">
          france@leyardgroup.com
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-bottom: 5rem;
  }

  .cta-card {
    padding: clamp(2.5rem, 5vw, 4rem);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .cta-card h2 {
    margin-bottom: 0.75rem;
  }

  .cta-card p {
    font-size: 1.05rem;
    max-width: 450px;
    margin: 0 auto 2rem;
  }

  .cta-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
