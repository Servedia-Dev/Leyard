---
const features = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Packages cle en main',
    description: "Tout est inclus : mecanique, cabinets, cables, electronique, finitions et pieces de rechange. Aucun cout cache.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: 'Technologies avancees',
    description: "SMD, COB, pitch ultra-fin. Nos technologies de pointe garantissent une qualite d'image incomparable.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Qualite europeenne',
    description: "Gamme DLP fabriquee en Europe. Normes strictes de qualite et certifications pour chaque produit.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    title: 'Presence mondiale',
    description: "Plus de 150 pays desservis avec un reseau de partenaires locaux pour un support de proximite.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    title: 'Installation simplifiee',
    description: "Colonnes all-in-one et systemes modulaires pour une installation rapide et sans complication.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    title: 'Support dedic',
    description: "Equipe technique disponible en France. Accompagnement de la conception au SAV, a chaque etape.",
  },
];
---

<section class="section features">
  <div class="container">
    <div class="section-header">
      <div class="badge">
        <span class="badge-dot"></span>
        Pourquoi Leyard
      </div>
      <h2>L'excellence LED <span class="gradient-text">a votre service</span></h2>
      <p>
        Depuis plus de 30 ans, Leyard innove pour offrir les meilleures
        solutions d'affichage LED au monde.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature, i) => (
        <div class="feature-card" style={`--delay: ${i * 0.08}s`}>
          <div class="feature-icon" set:html={feature.icon} />
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    padding: 2rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .feature-card:hover {
    border-color: rgba(108, 43, 217, 0.2);
    background: var(--color-bg-card);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-glow);
    border: 1px solid rgba(108, 43, 217, 0.2);
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
    color: var(--color-primary-light);
  }

  .feature-card h3 {
    font-size: 1.1rem;
    font-weight: 650;
    margin-bottom: 0.6rem;
    color: var(--color-text);
  }

  .feature-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
