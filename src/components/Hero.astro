---
---

<section class="hero">
  <div class="hero-bg">
    <div class="grid-lines"></div>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="glow glow-3"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-badge badge">
      <span class="badge-dot"></span>
      Leader mondial de l'affichage LED
    </div>

    <h1 class="hero-title">
      Des ecrans LED<br/>
      <span class="gradient-text">qui transforment</span><br/>
      vos espaces
    </h1>

    <p class="hero-description">
      Solutions d'affichage LED cle en main pour entreprises, collectivites
      et evenements. De la conception a l'installation, Leyard Europe
      vous accompagne avec des technologies de pointe.
    </p>

    <div class="hero-actions">
      <a href="/produits" class="btn btn-primary">
        Decouvrir nos produits
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/contact" class="btn btn-secondary">
        Demander un devis
      </a>
    </div>

    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value">30+</span>
        <span class="stat-label">Annees d'expertise</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">150+</span>
        <span class="stat-label">Pays desservis</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">N°1</span>
        <span class="stat-label">Mondial affichage LED</span>
      </div>
    </div>
  </div>

  <div class="hero-visual">
    <div class="screen-mockup">
      <div class="screen-frame">
        <div class="screen-content">
          <div class="pixel-grid">
            {Array.from({length: 6}).map((_, row) => (
              <div class="pixel-row">
                {Array.from({length: 8}).map((_, col) => (
                  <div class="pixel" style={`animation-delay: ${(row * 8 + col) * 0.05}s`}></div>
                ))}
              </div>
            ))}
          </div>
          <div class="screen-gradient"></div>
        </div>
      </div>
      <div class="screen-reflection"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 5rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .glow-1 {
    top: 10%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: rgba(108, 43, 217, 0.12);
    animation: float 8s ease-in-out infinite;
  }

  .glow-2 {
    bottom: 20%;
    right: 10%;
    width: 400px;
    height: 400px;
    background: rgba(6, 182, 212, 0.08);
    animation: float 10s ease-in-out infinite reverse;
  }

  .glow-3 {
    top: 50%;
    left: 50%;
    width: 300px;
    height: 300px;
    background: rgba(108, 43, 217, 0.06);
    animation: float 12s ease-in-out infinite;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
  }

  .hero-badge {
    margin-bottom: 1.75rem;
    animation: fadeInUp 0.6s ease-out;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .hero-title {
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.7s ease-out 0.1s both;
  }

  .hero-description {
    font-size: 1.15rem;
    max-width: 560px;
    margin-bottom: 2.5rem;
    animation: fadeInUp 0.7s ease-out 0.2s both;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 4rem;
    animation: fadeInUp 0.7s ease-out 0.3s both;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    animation: fadeInUp 0.7s ease-out 0.4s both;
  }

  .stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  /* LED Screen Visual */
  .hero-visual {
    position: absolute;
    right: -5%;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    pointer-events: none;
  }

  .screen-mockup {
    position: relative;
  }

  .screen-frame {
    width: 420px;
    height: 280px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
  }

  .screen-content {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .pixel-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px;
    height: 100%;
    justify-content: center;
  }

  .pixel-row {
    display: flex;
    gap: 4px;
    justify-content: center;
  }

  .pixel {
    width: 36px;
    height: 28px;
    border-radius: 3px;
    background: var(--gradient-primary);
    opacity: 0;
    animation: pixelFadeIn 0.5s ease-out forwards, pixelPulse 4s ease-in-out infinite;
  }

  @keyframes pixelFadeIn {
    to { opacity: 0.6; }
  }

  @keyframes pixelPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.7; }
  }

  .screen-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg,
      rgba(108, 43, 217, 0.15) 0%,
      rgba(6, 182, 212, 0.1) 50%,
      rgba(108, 43, 217, 0.05) 100%
    );
    pointer-events: none;
  }

  .screen-reflection {
    position: absolute;
    bottom: -40px;
    left: 10%;
    right: 10%;
    height: 40px;
    background: linear-gradient(to bottom, rgba(108, 43, 217, 0.06), transparent);
    filter: blur(8px);
  }

  @media (max-width: 1024px) {
    .hero-visual {
      display: none;
    }

    .hero-content {
      max-width: 100%;
      text-align: center;
    }

    .hero-description {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-stats {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero-stats {
      flex-direction: column;
      gap: 1.25rem;
    }

    .stat-divider {
      width: 40px;
      height: 1px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
