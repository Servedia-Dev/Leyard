---
const logos = [
  'Enterprise A', 'Corporate B', 'Global C',
  'Tech D', 'Media E', 'Group F',
];
---

<section class="section trust">
  <div class="container">
    <div class="trust-header">
      <p class="trust-label">Ils nous font confiance</p>
    </div>
    <div class="trust-logos">
      {logos.map(logo => (
        <div class="trust-logo">
          <span>{logo}</span>
        </div>
      ))}
    </div>

    <div class="testimonial-card">
      <div class="quote-mark">"</div>
      <blockquote>
        Leyard a completement transforme notre espace de conference.
        La qualite d'image est exceptionnelle et l'installation a ete
        realisee dans les delais. Un partenaire de confiance.
      </blockquote>
      <div class="testimonial-author">
        <div class="author-avatar">
          <span>JD</span>
        </div>
        <div>
          <strong>Jean Dupont</strong>
          <span>Directeur IT, Entreprise CAC40</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust {
    position: relative;
  }

  .trust-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .trust-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .trust-logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
    opacity: 0.4;
  }

  .trust-logo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .testimonial-card {
    max-width: 700px;
    margin: 0 auto;
    padding: 3rem;
    background: var(--gradient-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-align: center;
    position: relative;
  }

  .quote-mark {
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.3;
    position: absolute;
    top: 1rem;
    left: 2rem;
  }

  blockquote {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    font-style: italic;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--gradient-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    color: white;
  }

  .testimonial-author strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-text);
    text-align: left;
  }

  .testimonial-author span {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .trust-logos {
      gap: 1.5rem;
    }

    .testimonial-card {
      padding: 2rem;
    }
  }
</style>
