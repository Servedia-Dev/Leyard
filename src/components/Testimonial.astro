---
const series = ['Serie M', 'Serie URL', 'VDS', 'VHC', 'MGP', 'TVF', 'DLP', 'LUW', 'UC'];
---

<section class="section trust">
  <div class="container">
    <div class="trust-header">
      <span class="section-label">Gammes disponibles</span>
      <p class="trust-subtitle">Cliquez sur l'onglet Produits pour filtrer par serie et decouvrir nos packages.</p>
    </div>
    <div class="trust-series">
      {series.map(s => (
        <a href="/produits" class="series-tag">{s}</a>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--color-bg-alt);
  }

  .trust-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .trust-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .trust-series {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .series-tag {
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    transition: all var(--transition-fast);
  }

  .series-tag:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
