---
import Layout from '../layouts/Layout.astro';

const timeline = [
  { year: '1995', event: 'Fondation de Leyard', detail: 'Creation a Shenzhen, debut de la R&D en technologies LED.' },
  { year: '2004', event: 'Expansion internationale', detail: 'Ouverture des premiers bureaux en Amerique du Nord et en Europe.' },
  { year: '2012', event: 'Leader mondial', detail: 'Leyard devient le N°1 mondial des ecrans LED a pitch fin.' },
  { year: '2016', event: 'Acquisition Planar', detail: 'Integration de Planar Systems pour renforcer le portefeuille technologique.' },
  { year: '2020', event: 'Innovation COB', detail: 'Lancement des premieres gammes COB (Chip on Board) pour le marche europeen.' },
  { year: '2024', event: 'Leyard Europe', detail: 'Renforcement de la presence europeenne avec des gammes fabriquees en UE.' },
];

const values = [
  {
    title: 'Innovation',
    description: "Plus de 3000 brevets deposes. La R&D est au cour de notre ADN pour toujours repousser les limites du possible.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`,
  },
  {
    title: 'Qualite',
    description: "Certifications ISO, tests rigoureux et controle qualite a chaque etape de production pour une fiabilite sans faille.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Proximite',
    description: "Une equipe basee en France a votre ecoute. Support technique local et accompagnement personnalise.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
  {
    title: 'Durabilite',
    description: "Des produits concus pour durer avec une faible consommation energetique et des materiaux responsables.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M7 12l3 3 7-7"/></svg>`,
  },
];
---

<Layout title="A propos" description="Decouvrez Leyard Europe, leader mondial de l'affichage LED avec plus de 30 ans d'expertise.">

  <section class="page-hero">
    <div class="hero-glow-1"></div>
    <div class="hero-glow-2"></div>
    <div class="container">
      <div class="badge">
        <span class="dot"></span>
        Notre histoire
      </div>
      <h1>Leader mondial <span class="gradient-text">depuis 1995</span></h1>
      <p class="page-hero-desc">
        Leyard cree, fabrique et deploie des solutions d'affichage LED
        de pointe dans plus de 150 pays a travers le monde.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="section stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-block">
          <span class="stat-val">30+</span>
          <span class="stat-lbl">Annees d'experience</span>
        </div>
        <div class="stat-block">
          <span class="stat-val">150+</span>
          <span class="stat-lbl">Pays desservis</span>
        </div>
        <div class="stat-block">
          <span class="stat-val">3000+</span>
          <span class="stat-lbl">Brevets deposes</span>
        </div>
        <div class="stat-block">
          <span class="stat-val">10 000+</span>
          <span class="stat-lbl">Collaborateurs</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Nos <span class="gradient-text">valeurs</span></h2>
        <p>Les piliers qui guident chacune de nos actions et decisions.</p>
      </div>
      <div class="values-grid">
        {values.map(v => (
          <div class="value-card">
            <div class="value-icon" set:html={v.icon} />
            <h3>{v.title}</h3>
            <p>{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Notre <span class="gradient-text">parcours</span></h2>
        <p>Les etapes cles qui ont forge le leader mondial de l'affichage LED.</p>
      </div>
      <div class="timeline">
        {timeline.map((item, i) => (
          <div class="timeline-item" style={`--index: ${i}`}>
            <div class="timeline-marker">
              <span class="timeline-dot"></span>
            </div>
            <div class="timeline-content">
              <span class="timeline-year">{item.year}</span>
              <h3>{item.event}</h3>
              <p>{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    position: relative;
    padding: 10rem 0 4rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-glow-1 {
    position: absolute;
    top: 0;
    left: 30%;
    width: 500px;
    height: 400px;
    background: radial-gradient(circle, rgba(108, 43, 217, 0.1) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .hero-glow-2 {
    position: absolute;
    top: 20%;
    right: 20%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.07) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .page-hero .badge { margin-bottom: 1.5rem; }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
  }

  .page-hero-desc {
    font-size: 1.15rem;
    max-width: 500px;
    margin: 0 auto;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .stat-block {
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: var(--gradient-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .stat-val {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .stat-lbl {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* Values */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    padding: 2rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .value-card:hover {
    border-color: rgba(108, 43, 217, 0.2);
    transform: translateY(-2px);
  }

  .value-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-glow);
    border: 1px solid rgba(108, 43, 217, 0.2);
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
    color: var(--color-primary-light);
  }

  .value-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .value-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* Timeline */
  .section-alt {
    background: var(--color-bg-secondary);
  }

  .timeline {
    position: relative;
    padding-left: 3rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-primary), var(--color-accent), transparent);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -3rem;
    top: 0.25rem;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--gradient-primary);
    box-shadow: 0 0 12px rgba(108, 43, 217, 0.4);
  }

  .timeline-year {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    background: var(--gradient-glow);
    border: 1px solid rgba(108, 43, 217, 0.2);
    border-radius: 100px;
    color: var(--color-primary-light);
    margin-bottom: 0.5rem;
  }

  .timeline-content h3 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
    color: var(--color-text);
  }

  .timeline-content p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
