---
import Layout from '../layouts/Layout.astro';

const timeline = [
  { year: '1995', event: 'Fondation de Leyard', detail: 'Creation a Shenzhen, debut de la R&D en technologies LED.' },
  { year: '2004', event: 'Expansion internationale', detail: 'Ouverture des premiers bureaux en Amerique du Nord et en Europe.' },
  { year: '2012', event: 'Leader mondial', detail: 'Leyard devient le N°1 mondial des ecrans LED a pitch fin.' },
  { year: '2016', event: 'Acquisition Planar', detail: 'Integration de Planar Systems pour renforcer le portefeuille technologique.' },
  { year: '2020', event: 'Innovation COB', detail: 'Lancement des premieres gammes COB (Chip on Board) pour le marche europeen.' },
  { year: '2024', event: 'Leyard Europe', detail: 'Renforcement de la presence europeenne avec des gammes fabriquees en UE.' },
];

const values = [
  {
    title: 'Innovation',
    description: "Plus de 3000 brevets deposes. La R&D est au coeur de notre ADN pour toujours repousser les limites du possible.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`,
  },
  {
    title: 'Qualite',
    description: "Certifications ISO, tests rigoureux et controle qualite a chaque etape de production pour une fiabilite sans faille.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Proximite',
    description: "Une equipe basee en France a votre ecoute. Support technique local et accompagnement personnalise.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
  {
    title: 'Durabilite',
    description: "Des produits concus pour durer avec une faible consommation energetique et des materiaux responsables.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M7 12l3 3 7-7"/></svg>`,
  },
];
---

<Layout title="A propos" description="Decouvrez Leyard Europe, leader mondial de l'affichage LED avec plus de 30 ans d'expertise.">

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Notre histoire</span>
      <h1>Leader mondial depuis 1995</h1>
      <p class="page-hero-desc">
        Leyard cree, fabrique et deploie des solutions d'affichage LED
        de pointe dans plus de 150 pays a travers le monde.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-block">
          <span class="stat-val">30+</span>
          <span class="stat-lbl">Annees d'experience</span>
        </div>
        <div class="stat-block">
          <span class="stat-val">150+</span>
          <span class="stat-lbl">Pays desservis</span>
        </div>
        <div class="stat-block">
          <span class="stat-val">3000+</span>
          <span class="stat-lbl">Brevets deposes</span>
        </div>
        <div class="stat-block">
          <span class="stat-val">10 000+</span>
          <span class="stat-lbl">Collaborateurs</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Nos valeurs</h2>
        <p>Les piliers qui guident chacune de nos actions et decisions.</p>
      </div>
      <div class="values-grid">
        {values.map(v => (
          <div class="value-card">
            <div class="value-icon" set:html={v.icon} />
            <h3>{v.title}</h3>
            <p>{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Notre parcours</h2>
        <p>Les etapes cles qui ont forge le leader mondial de l'affichage LED.</p>
      </div>
      <div class="timeline">
        {timeline.map(item => (
          <div class="timeline-item">
            <div class="timeline-marker">
              <span class="timeline-dot"></span>
            </div>
            <div class="timeline-content">
              <span class="timeline-year">{item.year}</span>
              <h3>{item.event}</h3>
              <p>{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    margin-bottom: 0.75rem;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    max-width: 500px;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .stat-block {
    text-align: center;
    padding: 2rem 1.25rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .stat-val {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .stat-lbl {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* Values */
  .section-alt {
    background: var(--color-bg-alt);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .value-card {
    padding: 1.75rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base);
  }

  .value-card:hover {
    border-color: var(--color-primary-light);
  }

  .value-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .value-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
    color: var(--color-text);
  }

  .value-card p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 2.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -2.5rem;
    top: 0.25rem;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .timeline-year {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.6rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    margin-bottom: 0.4rem;
  }

  .timeline-content h3 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }

  .timeline-content p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
