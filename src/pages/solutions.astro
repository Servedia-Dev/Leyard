---
import Layout from '../layouts/Layout.astro';

const solutions = [
  {
    title: 'Salles de reunion & Collaboration',
    description: "Transformez vos espaces de travail avec des ecrans LED interactifs haute resolution. Presentez, collaborez et communiquez avec un impact visuel incomparable. Nos solutions all-in-one s'installent en quelques heures.",
    features: ['Visioconference HD', 'Ecran tactile', 'Partage sans fil', 'Installation rapide'],
    stats: { value: '85%', label: "d'engagement en plus" },
  },
  {
    title: 'Retail & Points de vente',
    description: "Captez l'attention de vos clients avec des murs d'images LED saisissants. Affichez vos produits, promotions et contenus de marque sur des ecrans grand format qui ne passent pas inapercu.",
    features: ['Grand format', 'Haute luminosite', 'Contenu dynamique', 'Pilotage a distance'],
    stats: { value: '3x', label: 'plus de temps d\'arret' },
  },
  {
    title: 'Evenementiel & Spectacle',
    description: "Des ecrans geants pour vos concerts, salons, conferences et evenements sportifs. Nos solutions outdoor et indoor garantissent un impact visuel maximal quelle que soit la taille de votre audience.",
    features: ['Indoor & Outdoor', 'Montage rapide', 'Formats geants', 'Haute luminosite'],
    stats: { value: '150+', label: 'evenements/an' },
  },
  {
    title: 'Corporate & Accueil',
    description: "Modernisez vos halls d'accueil, showrooms et espaces de direction avec des affichages LED elegants. Renforcez votre image de marque des le premier regard.",
    features: ['Design elegant', 'Silencieux', 'Faible consommation', 'Contenu pilote'],
    stats: { value: '100%', label: 'sur mesure' },
  },
  {
    title: 'Controle & Supervision',
    description: "Murs d'images pour centres de controle, salles de crise et supervision. Affichez des dizaines de sources simultanement avec une fiabilite 24/7.",
    features: ['Fonctionnement 24/7', 'Multi-sources', 'Redundance', 'Zero maintenance'],
    stats: { value: '99.9%', label: 'de disponibilite' },
  },
  {
    title: 'Education & Culture',
    description: "Amphitheatres, musees, mediatheques. Des solutions LED pensees pour l'enseignement et la diffusion culturelle avec une qualite d'image respectueuse des contenus.",
    features: ['Grands amphitheatres', 'Museographie', 'Fidelite couleurs', 'Accessibilite'],
    stats: { value: '4K+', label: 'resolution' },
  },
];
---

<Layout title="Nos solutions" description="Solutions d'affichage LED pour salles de reunion, retail, evenementiel, corporate et supervision.">

  <section class="page-hero">
    <div class="hero-glow-1"></div>
    <div class="hero-glow-2"></div>
    <div class="container">
      <div class="badge">
        <span class="dot"></span>
        Applications metier
      </div>
      <h1>Des solutions <span class="gradient-text">sur mesure</span></h1>
      <p class="page-hero-desc">
        Quel que soit votre secteur d'activite, Leyard Europe
        propose une solution LED adaptee a vos enjeux.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="solutions-list">
        {solutions.map((sol, i) => (
          <div class="sol-card" style={`--index: ${i}`}>
            <div class="sol-visual">
              <div class="sol-stat">
                <span class="sol-stat-value">{sol.stats.value}</span>
                <span class="sol-stat-label">{sol.stats.label}</span>
              </div>
            </div>
            <div class="sol-content">
              <h3>{sol.title}</h3>
              <p>{sol.description}</p>
              <div class="sol-features">
                {sol.features.map(f => <span class="sol-ftag">{f}</span>)}
              </div>
              <a href="/contact" class="sol-link">
                Discuter de ce projet
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    position: relative;
    padding: 10rem 0 4rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-glow-1 {
    position: absolute;
    top: 0;
    left: 30%;
    width: 500px;
    height: 400px;
    background: radial-gradient(circle, rgba(108, 43, 217, 0.1) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .hero-glow-2 {
    position: absolute;
    top: 20%;
    right: 20%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.07) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .page-hero .badge { margin-bottom: 1.5rem; }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
  }

  .page-hero-desc {
    font-size: 1.15rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .solutions-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sol-card {
    display: flex;
    gap: 2.5rem;
    padding: 2.5rem;
    background: var(--gradient-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .sol-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
  }

  .sol-card:nth-child(even) {
    flex-direction: row-reverse;
  }

  .sol-visual {
    flex-shrink: 0;
    width: 220px;
    height: 180px;
    background: var(--color-bg-elevated);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .sol-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 60% 40%, rgba(108, 43, 217, 0.08) 0%, transparent 60%);
  }

  .sol-stat {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .sol-stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }

  .sol-stat-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .sol-content {
    flex: 1;
  }

  .sol-content h3 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .sol-content p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .sol-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .sol-ftag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    background: var(--gradient-glow);
    border: 1px solid rgba(108, 43, 217, 0.15);
    border-radius: 100px;
    color: var(--color-primary-light);
  }

  .sol-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary-light);
    transition: all var(--transition-fast);
  }

  .sol-link:hover {
    color: var(--color-accent-light);
    gap: 0.65rem;
  }

  @media (max-width: 768px) {
    .sol-card,
    .sol-card:nth-child(even) {
      flex-direction: column;
    }

    .sol-visual {
      width: 100%;
      height: 140px;
    }
  }
</style>
