---
import Layout from '../layouts/Layout.astro';

const solutions = [
  {
    title: 'Salles de reunion & Collaboration',
    description: "Transformez vos espaces de travail avec des ecrans LED interactifs haute resolution. Presentez, collaborez et communiquez avec un impact visuel incomparable. Nos solutions all-in-one s'installent en quelques heures.",
    features: ['Visioconference HD', 'Ecran tactile', 'Partage sans fil', 'Installation rapide'],
    image: 'https://www.planar.com/media/442435/workspaces-market-homepage-706x530.jpg',
  },
  {
    title: 'Retail & Points de vente',
    description: "Captez l'attention de vos clients avec des murs d'images LED saisissants. Affichez vos produits, promotions et contenus de marque sur des ecrans grand format qui ne passent pas inapercu.",
    features: ['Grand format', 'Haute luminosite', 'Contenu dynamique', 'Pilotage a distance'],
    image: 'https://www.planar.com/media/442437/retail-market-homepage-706x530.jpg',
  },
  {
    title: 'Evenementiel & Spectacle',
    description: "Des ecrans geants pour vos concerts, salons, conferences et evenements sportifs. Nos solutions outdoor et indoor garantissent un impact visuel maximal quelle que soit la taille de votre audience.",
    features: ['Indoor & Outdoor', 'Montage rapide', 'Formats geants', 'Haute luminosite'],
    image: 'https://www.planar.com/media/442439/events-market-homepage-706x530.jpg',
  },
  {
    title: 'Corporate & Accueil',
    description: "Modernisez vos halls d'accueil, showrooms et espaces de direction avec des affichages LED elegants. Renforcez votre image de marque des le premier regard.",
    features: ['Design elegant', 'Silencieux', 'Faible consommation', 'Contenu pilote'],
    image: 'https://www.planar.com/media/442426/digital-signage-market-homepage-706x530.jpg',
  },
  {
    title: 'Controle & Supervision',
    description: "Murs d'images pour centres de controle, salles de crise et supervision. Affichez des dizaines de sources simultanement avec une fiabilite 24/7.",
    features: ['Fonctionnement 24/7', 'Multi-sources', 'Redundance', 'Zero maintenance'],
    image: 'https://www.planar.com/media/442425/control-rooms-market-homepage-706x530.jpg',
  },
  {
    title: 'Education & Culture',
    description: "Amphitheatres, musees, mediatheques. Des solutions LED pensees pour l'enseignement et la diffusion culturelle avec une qualite d'image respectueuse des contenus.",
    features: ['Grands amphitheatres', 'Museographie', 'Fidelite couleurs', 'Accessibilite'],
    image: 'https://www.planar.com/media/442429/higher-education-market-homepage-706x530.jpg',
  },
];
---

<Layout title="Nos solutions" description="Solutions d'affichage LED pour salles de reunion, retail, evenementiel, corporate et supervision.">

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Applications metier</span>
      <h1>Des solutions sur mesure</h1>
      <p class="page-hero-desc">
        Quel que soit votre secteur d'activite, Leyard Europe
        propose une solution LED adaptee a vos enjeux.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="solutions-list">
        {solutions.map((sol, i) => (
          <div class:list={['sol-card', i % 2 !== 0 && 'sol-card--reverse']}>
            <div class="sol-image">
              <img src={sol.image} alt={sol.title} loading="lazy" />
            </div>
            <div class="sol-content">
              <h3>{sol.title}</h3>
              <p>{sol.description}</p>
              <div class="sol-features">
                {sol.features.map(f => <span class="sol-ftag">{f}</span>)}
              </div>
              <a href="/contact" class="sol-link">
                Discuter de ce projet
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 { margin-bottom: 0.75rem; }

  .page-hero-desc {
    font-size: 1.1rem;
    max-width: 500px;
  }

  .solutions-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sol-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base);
  }

  .sol-card:hover {
    border-color: var(--color-primary-light);
  }

  .sol-card--reverse {
    direction: rtl;
  }

  .sol-card--reverse > * {
    direction: ltr;
  }

  .sol-image {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .sol-image img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-md);
  }

  .sol-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
    color: var(--color-text);
  }

  .sol-content p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .sol-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .sol-ftag {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  .sol-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }

  .sol-link:hover { gap: 0.55rem; }

  @media (max-width: 768px) {
    .sol-card,
    .sol-card--reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }
  }
</style>
