  },
  {
    name: 'MGP',
    type: 'Cabinet LED - SMD',
    pitch: '0.9 - 1.8mm',
    description: "Gamme SMD polyvalente offrant un excellent compromis entre performance et accessibilite.",
    features: ['SMD polyvalent', 'Rapport qualite/prix', 'Modulaire', 'Multi-usage'],
    image: 'https://complete.leyard.fr/wp-content/uploads/2023/09/Complete4K.png',
