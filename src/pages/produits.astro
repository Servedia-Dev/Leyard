---
import Layout from '../layouts/Layout.astro';

const allInOne = [
  {
    name: 'Serie M',
    type: 'Colonne All-in-One',
    pitch: '0.9 - 2.5mm',
    description: "Mur LED d'entree de gamme avec fonctions PIP integrees. Solution ideale pour les salles de reunion et espaces collaboratifs.",
    features: ['PIP integre', 'Installation en colonne', 'Plug & Play', 'Entree de gamme'],
    tag: 'Populaire',
  },
  {
    name: 'Serie URL',
    type: 'Colonne All-in-One',
    pitch: '0.9 - 1.8mm',
    description: "Mur LED tactile premium avec processeur PIP haut de gamme. L'experience interactive ultime pour les espaces de decision.",
    features: ['Ecran tactile', 'Processeur PIP premium', 'Interactif', 'Ultra HD'],
    tag: 'Premium',
  },
];

const cabinets = [
  {
    name: 'VDS',
    type: 'Cabinet LED - COB',
    pitch: '0.4 - 1.2mm',
    description: "Technologie COB de pointe avec option cadre tactile. Performance et durabilite exceptionnelles pour les installations permanentes.",
    features: ['Technologie COB', 'Cadre tactile optionnel', 'Ultra haute resolution', 'Maintenance facilitee'],
    tag: 'Innovation',
  },
  {
    name: 'VHC',
    type: 'Cabinet LED - SMD',
    pitch: '1.2 - 2.5mm',
    description: "Solution SMD entree de gamme pour les projets a budget maitrise sans compromis sur la qualite.",
    features: ['SMD entree de gamme', 'Budget maitrise', 'Fiabilite', 'Grand format'],
  },
  {
    name: 'MGP',
    type: 'Cabinet LED - SMD',
    pitch: '0.9 - 1.8mm',
    description: "Gamme SMD polyvalente offrant un excellent compromis entre performance et accessibilite.",
    features: ['SMD polyvalent', 'Rapport qualite/prix', 'Modulaire', 'Multi-usage'],
  },
  {
    name: 'TVF',
    type: 'Cabinet LED - SMD',
    pitch: '0.7 - 1.5mm',
    description: "SMD milieu de gamme avec une qualite d'image remarquable. Le choix de reference pour les projets professionnels.",
    features: ['Milieu de gamme', 'Image remarquable', 'Professionnel', 'Polyvalent'],
    tag: 'Best-seller',
  },
  {
    name: 'DLP',
    type: 'Cabinet LED - SMD Premium',
    pitch: '0.7 - 1.2mm',
    description: "SMD haut de gamme fabrique en Union Europeenne. La reference premium pour les installations les plus exigeantes.",
    features: ['Fabrique en UE', 'Haut de gamme', 'Certifie', 'Support premium'],
    tag: 'Made in EU',
  },
];

const specialty = [
  {
    name: 'LUW',
    type: 'Outdoor',
    pitch: '2.5 - 6mm',
    description: "Pitch ultra-fin pour l'exterieur avec haute luminosite. Images eclatantes meme en plein soleil.",
    features: ['Exterieur', 'Ultra-fin outdoor', 'Haute luminosite', 'IP65+'],
    tag: 'Outdoor',
  },
  {
    name: 'UC',
    type: 'Formats speciaux',
    pitch: '0.9 - 1.5mm',
    description: "Formats 21/9 et 32/9 pour des installations cinematiques et immersives uniques.",
    features: ['Format 21/9', 'Format 32/9', 'Cinematique', 'Immersif'],
    tag: 'Special',
  },
];
---

<Layout title="Nos produits LED" description="Decouvrez notre gamme complete d'ecrans LED : colonnes all-in-one, cabinets SMD et COB, solutions outdoor.">

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Catalogue complet</span>
      <h1>Nos ecrans LED</h1>
      <p class="page-hero-desc">
        Des packages tout-en-un incluant mecanique, cabinets, cables,
        electronique, finitions et pieces de rechange.
      </p>
    </div>
  </section>

  <!-- All-in-One -->
  <section class="section" id="all-in-one">
    <div class="container">
      <div class="category-header">
        <h2>Colonnes All-in-One</h2>
        <p>Solutions integrees en colonne avec processeur LED embarque. Branchez, allumez, projetez.</p>
      </div>
      <div class="products-list">
        {allInOne.map(product => (
          <div class="product-row">
            <div class="product-details">
              <div class="product-top">
                <div>
                  <h3>{product.name}</h3>
                  <span class="product-type">{product.type}</span>
                </div>
                {product.tag && <span class="product-tag">{product.tag}</span>}
              </div>
              <span class="product-pitch">Pitch : {product.pitch}</span>
              <p>{product.description}</p>
              <div class="product-features">
                {product.features.map(f => <span class="ftag">{f}</span>)}
              </div>
              <a href="/contact" class="product-cta">
                Demander un devis
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cabinets -->
  <section class="section section-alt" id="cabinets">
    <div class="container">
      <div class="category-header">
        <h2>Cabinets LED</h2>
        <p>Systemes modulaires avec processeur LED deporte pour une flexibilite maximale.</p>
      </div>
      <div class="products-list">
        {cabinets.map(product => (
          <div class="product-row">
            <div class="product-details">
              <div class="product-top">
                <div>
                  <h3>{product.name}</h3>
                  <span class="product-type">{product.type}</span>
                </div>
                {product.tag && <span class="product-tag">{product.tag}</span>}
              </div>
              <span class="product-pitch">Pitch : {product.pitch}</span>
              <p>{product.description}</p>
              <div class="product-features">
                {product.features.map(f => <span class="ftag">{f}</span>)}
              </div>
              <a href="/contact" class="product-cta">
                Demander un devis
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Specialty -->
  <section class="section" id="outdoor">
    <div class="container">
      <div class="category-header">
        <h2>Solutions speciales</h2>
        <p>Outdoor haute luminosite et formats cinematiques pour des installations uniques.</p>
      </div>
      <div class="products-list">
        {specialty.map(product => (
          <div class="product-row">
            <div class="product-details">
              <div class="product-top">
                <div>
                  <h3>{product.name}</h3>
                  <span class="product-type">{product.type}</span>
                </div>
                {product.tag && <span class="product-tag">{product.tag}</span>}
              </div>
              <span class="product-pitch">Pitch : {product.pitch}</span>
              <p>{product.description}</p>
              <div class="product-features">
                {product.features.map(f => <span class="ftag">{f}</span>)}
              </div>
              <a href="/contact" class="product-cta">
                Demander un devis
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Page Hero */
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 {
    margin-bottom: 0.75rem;
  }

  .page-hero-desc {
    font-size: 1.1rem;
    max-width: 560px;
  }

  /* Category */
  .category-header {
    margin-bottom: 2.5rem;
  }

  .category-header h2 {
    margin-bottom: 0.5rem;
  }

  .category-header p {
    font-size: 1rem;
    max-width: 500px;
  }

  .section-alt {
    background: var(--color-bg-alt);
  }

  /* Product rows */
  .products-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product-row {
    padding: 1.75rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base);
  }

  .product-row:hover {
    border-color: var(--color-primary-light);
  }

  .product-details {
    flex: 1;
  }

  .product-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .product-top h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .product-type {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .product-tag {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .product-pitch {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.6rem;
  }

  .product-details > p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.65;
  }

  .product-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .ftag {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  .product-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }

  .product-cta:hover {
    gap: 0.55rem;
  }
</style>
