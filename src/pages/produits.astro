function renderProducts(products: typeof allInOne) {
  return products;
}
---

<Layout title="Nos produits LED" description="Decouvrez notre gamme complete d'ecrans LED : colonnes all-in-one, cabinets SMD et COB, solutions outdoor.">

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Catalogue complet</span>
      <h1>Nos ecrans LED</h1>
      <p class="page-hero-desc">
        Des packages tout-en-un incluant mecanique, cabinets, cables,
        electronique, finitions et pieces de rechange.
      </p>
    </div>
  </section>

  <!-- All-in-One -->
  <section class="section" id="all-in-one">
    <div class="container">
      <div class="category-header">
        <h2>Colonnes All-in-One</h2>
        <p>Solutions integrees en colonne avec processeur LED embarque. Branchez, allumez, projetez.</p>
      </div>
      <div class="products-grid">
        {allInOne.map(product => (
          <div class="product-card">
            <div class="card-img">
              <img src={product.image} alt={product.name} loading="lazy" />
              {product.tag && <span class="card-tag">{product.tag}</span>}
            </div>
            <div class="card-body">
              <div class="card-top">
                <div>
                  <h3>{product.name}</h3>
                  <span class="product-type">{product.type}</span>
                </div>
                <span class="product-pitch">{product.pitch}</span>
              </div>
              <p>{product.description}</p>
              <div class="product-features">
                {product.features.map(f => <span class="ftag">{f}</span>)}
              </div>
              <a href="/contact" class="product-cta">
                Demander un devis
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cabinets -->
  <section class="section section-alt" id="cabinets">
    <div class="container">
      <div class="category-header">
        <h2>Cabinets LED</h2>
        <p>Systemes modulaires avec processeur LED deporte pour une flexibilite maximale.</p>
      </div>
      <div class="products-grid">
        {cabinets.map(product => (
          <div class="product-card">
            <div class="card-img">
              <img src={product.image} alt={product.name} loading="lazy" />
              {product.tag && <span class="card-tag">{product.tag}</span>}
            </div>
            <div class="card-body">
              <div class="card-top">
                <div>
                  <h3>{product.name}</h3>
                  <span class="product-type">{product.type}</span>
                </div>
                <span class="product-pitch">{product.pitch}</span>
              </div>
              <p>{product.description}</p>
              <div class="product-features">
                {product.features.map(f => <span class="ftag">{f}</span>)}
              </div>
              <a href="/contact" class="product-cta">
                Demander un devis
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Specialty -->
  <section class="section" id="outdoor">
    <div class="container">
      <div class="category-header">
        <h2>Solutions speciales</h2>
        <p>Outdoor haute luminosite et formats cinematiques pour des installations uniques.</p>
      </div>
      <div class="products-grid">
        {specialty.map(product => (
          <div class="product-card">
            <div class="card-img">
              <img src={product.image} alt={product.name} loading="lazy" />
              {product.tag && <span class="card-tag">{product.tag}</span>}
            </div>
            <div class="card-body">
              <div class="card-top">
                <div>
                  <h3>{product.name}</h3>
                  <span class="product-type">{product.type}</span>
                </div>
                <span class="product-pitch">{product.pitch}</span>
              </div>
              <p>{product.description}</p>
              <div class="product-features">
                {product.features.map(f => <span class="ftag">{f}</span>)}
              </div>
              <a href="/contact" class="product-cta">
                Demander un devis
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 4rem 0 3rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero h1 { margin-bottom: 0.75rem; }

  .page-hero-desc {
    font-size: 1.1rem;
    max-width: 560px;
  }

  .category-header {
    margin-bottom: 2rem;
  }

  .category-header h2 { margin-bottom: 0.5rem; }

  .category-header p {
    font-size: 1rem;
    max-width: 500px;
  }

  .section-alt {
    background: var(--color-bg-alt);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .product-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .product-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .card-img {
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
  }

  .card-img img {
    width: 100%;
    height: 170px;
    object-fit: contain;
    display: block;
    padding: 0.75rem;
    transition: transform 0.4s ease;
  }

  .product-card:hover .card-img img {
    transform: scale(1.03);
  }

  .card-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-sm);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-body {
    padding: 1.25rem;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .card-top h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .product-type {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .product-pitch {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .card-body > p {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.85rem;
    line-height: 1.55;
  }

  .product-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.85rem;
  }

  .ftag {
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.15rem 0.5rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  .product-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap var(--transition-fast);
  }

  .product-cta:hover { gap: 0.55rem; }

  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
